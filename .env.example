# Resend API key — needs "Full access" (sending-only keys cannot store or look up contacts).
RESEND_API_KEY=

# Inbox that receives a note for every new signup (also the reply-to on welcome emails).
WAITLIST_TO=you@example.com

# Verified sender; onboarding@resend.dev only delivers to your own Resend email.
WAITLIST_FROM=Cadence <onboarding@resend.dev>

# Optional: canonical site URL for share images, sitemap and robots.
# Defaults to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
